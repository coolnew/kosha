# Normalize all text files to LF in the repo and in the working tree.
* text=auto eol=lf

# Explicit text types (belt and braces for tools that skip auto-detection).
*.rs        text eol=lf diff=rust
*.toml      text eol=lf
*.lock      text eol=lf -diff linguist-generated
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.svg       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Windows-only scripts genuinely need CRLF to run.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets: never touch, never diff as text.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
*.pdf       binary

# Optional recipe packs are available in Git and omitted from source archives.
/marketplace export-ignore
